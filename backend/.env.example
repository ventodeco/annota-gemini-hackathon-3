# AI Provider Configuration
# AI_PROVIDER=minimax uses OpenRouter for OCR and MiniMax for analyze/TTS.
# AI_PROVIDER=gemini uses Gemini for OCR, analyze, and TTS.
AI_PROVIDER=minimax

# Required when AI_PROVIDER=gemini. GOOGLE_API_KEY is also accepted as a fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Required when AI_PROVIDER=minimax.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_OCR_MODEL=baidu/qianfan-ocr-fast:free

# Required when AI_PROVIDER=minimax.
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_TTS_BASE_URL=https://api-uw.minimax.io/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE_ID=Japanese_Whisper_Belle

# Application Configuration
APP_ENV=development
APP_BASE_URL=http://localhost:8080
# Frontend callback target for OAuth redirects.
# In split dev mode (backend :8080 + vite :5173), set this to :5173.
# Leave unset in production to default to APP_BASE_URL.
FRONTEND_BASE_URL=http://localhost:5173
PORT=8080

# Database Configuration
# Option A: provide full PostgreSQL connection string (takes precedence when set)
# Format: host=... port=... user=... password=... dbname=... sslmode=...
DB_CONNECTION_STRING=

# Option B: provide PostgreSQL components (used when DB_CONNECTION_STRING is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=gemini_db
POSTGRES_SSLMODE=disable

# File Storage Configuration
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=10485760

# Session Configuration
SESSION_COOKIE_NAME=sid
SESSION_SECURE=false

KNOWLEDGE_CSV_PATH=data/knowledge/knowledge-service.md

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "https://app.example.com,https://admin.example.com")
# Use "*" only for local experiments. Production startup rejects wildcard origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth Configuration (Google)
# Note: We intentionally support 2 Google OAuth clients across app environments.
# This backend uses one client pair via these variables.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# JWT Configuration
# Generate a secure random string. Startup requires at least 32 characters.
JWT_SECRET=replace_with_at_least_32_random_chars
TOKEN_EXPIRY_MINUTES=30

# Redis Configuration
# Used for OAuth state storage and caching
REDIS_ADDR=localhost:6379

# Pagination Configuration
DEFAULT_PAGE_SIZE=20

# AI-backed route controls
# Set AI_RATE_LIMIT=0 to disable locally. Keep enabled in production.
AI_RATE_LIMIT=60
AI_RATE_LIMIT_WINDOW_SECONDS=3600
