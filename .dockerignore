# The root context is used only by web/Dockerfile. Keep the workspace inputs.
**
!package.json
!bun.lock
!web/
!web/**

# Never copy local configuration, dependencies, or generated output into builds.
**/.env
**/.env.*
**/node_modules
**/dist
**/data
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/*.log
**/.git
**/.DS_Store
